{
	"$schema": "https://typedoc.org/schema.json",
	"entryPoints": ["src/index.ts", "src/devtools-entry.ts"],
	"out": ".typedoc",
	"name": "@ispoofermotion/core",
	"includeVersion": true,
	"excludeInternal": true,
	"excludePrivate": true,
	"plugin": [],
	"readme": "README.md",
	"validation": {
		"notExported": true,
		"invalidLink": true,
		"notDocumented": false
	},
	"treatWarningsAsErrors": true
}
